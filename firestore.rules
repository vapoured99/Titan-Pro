rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helper
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Resource Owner Helper
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User data match block
    match /users/{userId} {
      // Allow user to read/write their own profile and documents
      allow read, write: if isOwner(userId);
      
      // Cascading matches for subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global shared custom routes collection
    match /global_custom_routes/{routeId} {
      allow read, write: if true;
    }
  }
}
